// Prisma schema for Soke — Eyes on the Street
// This schema mirrors the Neon PostgreSQL tables managed by db.ts
// Use `npx prisma generate` to generate the client, `npx prisma db push` to sync

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DATABASE_URL")
}

// ─── Geo Hierarchy ───

model Region {
  id        Int      @id @default(autoincrement())
  name      String   @unique
  code      String?
  slug      String?
  createdAt DateTime @default(now()) @map("created_at")

  states    State[]

  @@map("regions")
}

model State {
  id              Int      @id @default(autoincrement())
  name            String   @unique
  regionId        Int?     @map("region_id")
  code            String?
  portalId        Int?     @map("portal_id")
  lat             Float?
  lng             Float?
  source          String?
  sourceUpdatedAt DateTime? @map("source_updated_at")
  createdAt       DateTime @default(now()) @map("created_at")

  region          Region?  @relation(fields: [regionId], references: [id])
  lgas            Lga[]
  wards           Ward[]
  microTruths     MicroTruth[]

  @@map("states")
}

model Lga {
  id              Int      @id @default(autoincrement())
  name            String
  stateId         Int?     @map("state_id")
  code            String?
  portalId        Int?     @map("portal_id")
  lat             Float?
  lng             Float?
  source          String?
  sourceUpdatedAt DateTime? @map("source_updated_at")
  createdAt       DateTime @default(now()) @map("created_at")

  state           State?   @relation(fields: [stateId], references: [id])
  wards           Ward[]
  microTruths     MicroTruth[]

  @@map("lgas")
}

model Village {
  id        Int      @id @default(autoincrement())
  name      String
  lgaId     Int?     @map("lga_id")
  lat       Float?
  lng       Float?
  createdAt DateTime @default(now()) @map("created_at")

  @@map("villages")
}

model Community {
  id        Int      @id @default(autoincrement())
  name      String
  villageId Int?     @map("village_id")
  geoHash   String   @map("geo_hash")
  lat       Float
  lng       Float
  wardId    Int?     @map("ward_id")
  stateId   Int?     @map("state_id")
  lgaId     Int?     @map("lga_id")
  region    String?
  slug      String?
  createdAt DateTime @default(now()) @map("created_at")

  microTruths MicroTruth[]

  @@map("communities")
}

// ─── Core Tables ───

model Neighborhood {
  id        Int      @id @default(autoincrement())
  name      String
  region    String
  geoHash   String   @map("geo_hash")
  lat       Float
  lng       Float
  state     String?
  lga       String?
  community String?
  village   String?
  createdAt DateTime @default(now()) @map("created_at")

  @@map("neighborhoods")
}

model MicroTruth {
  id                 Int      @id @default(autoincrement())
  neighborhoodId     Int      @map("neighborhood_id")
  category           String
  content            String
  trustScore         Int      @default(50) @map("trust_score")
  decayFactor        Float    @default(1.0) @map("decay_factor")
  verificationChain  String   @default("[]") @map("verification_chain")
  userHash           String   @map("user_hash")
  status             String   @default("pending")
  createdAt          DateTime @default(now()) @map("created_at")
  ipHash             String?  @map("ip_hash")
  ipRegion           String?  @map("ip_region")
  ipCity             String?  @map("ip_city")
  reportLat          Float?   @map("report_lat")
  reportLng          Float?   @map("report_lng")
  locationSource     String?  @map("location_source")
  organizationId     Int?     @map("organization_id")
  // Geo hierarchy
  stateName          String?  @map("state_name")
  lgaName            String?  @map("lga_name")
  communityName      String?  @map("community_name")
  villageName        String?  @map("village_name")
  regionName         String?  @map("region_name")
  // Soft delete (removed from website, retained in database)
  deletedAt          DateTime? @map("deleted_at")
  deletedBy          String?  @map("deleted_by")
  deleteReason       String?  @map("delete_reason")

  // ─── Community Feeds System: geo hierarchy FKs ───
  stateId            Int?     @map("state_id")
  lgaId              Int?     @map("lga_id")
  wardId             Int?     @map("ward_id")
  communityId        Int?     @map("community_id")

  // ─── AI-driven columns ───
  aiTags             String   @default("[]") @map("ai_tags")
  aiCategory         String?  @map("ai_category")
  aiSpamScore        Float    @default(0.0) @map("ai_spam_score")
  aiSpamFlags        String   @default("[]") @map("ai_spam_flags")
  trendingScore      Float    @default(0.0) @map("trending_score")
  trendingRank       Int?     @map("trending_rank")
  aiAnalyzedAt       DateTime? @map("ai_analyzed_at")

  // ─── Relations ───
  state              State?   @relation(fields: [stateId], references: [id])
  lga                Lga?     @relation(fields: [lgaId], references: [id])
  ward               Ward?    @relation(fields: [wardId], references: [id])
  community          Community? @relation(fields: [communityId], references: [id])

  @@map("micro_truths")
}

model Snapshot {
  id             Int      @id @default(autoincrement())
  neighborhoodId Int      @map("neighborhood_id")
  powerStatus    String   @map("power_status")
  fuelStatus     String   @map("fuel_status")
  trafficLevel   String   @map("traffic_level")
  priceIndex     Int      @default(100) @map("price_index")
  safetyIndex    Int      @default(70) @map("safety_index")
  activeTruths   Int      @default(0) @map("active_truths")
  updatedAt      DateTime @default(now()) @map("updated_at")

  @@map("snapshots")
}

model Prediction {
  id             Int      @id @default(autoincrement())
  category       String
  neighborhoodId Int      @map("neighborhood_id")
  prediction     String
  confidence     Int      @default(50)
  timeframe      String
  trend          String   @default("stable")
  modelVersion   String   @default("soke-heuristic-v1") @map("model_version")
  createdAt      DateTime @default(now()) @map("created_at")

  @@map("predictions")
}

model RewardLedger {
  id          Int      @id @default(autoincrement())
  userHash    String   @map("user_hash")
  amount      Int
  type        String
  description String
  createdAt   DateTime @default(now()) @map("created_at")

  @@map("reward_ledger")
}

model DeviceProfile {
  id               Int      @id @default(autoincrement())
  deviceIdHash     String   @unique @map("device_id_hash")
  trustScore       Int      @default(50) @map("trust_score")
  totalSubmissions Int      @default(0) @map("total_submissions")
  rewardsBalance   Int      @default(0) @map("rewards_balance")
  createdAt        DateTime @default(now()) @map("created_at")

  @@map("device_profiles")
}

model Verification {
  id        Int      @id @default(autoincrement())
  truthId   Int      @map("truth_id")
  userHash  String   @map("user_hash")
  action    String
  createdAt DateTime @default(now()) @map("created_at")

  @@unique([truthId, userHash], name: "idx_verifications_truth_user")
  @@map("verifications")
}

model Organization {
  id           Int      @id @default(autoincrement())
  name         String
  type         String
  description  String?
  contactEmail String   @map("contact_email")
  contactPhone String?  @map("contact_phone")
  website      String?
  logoUrl      String?  @map("logo_url")
  region       String?
  city         String?
  lat          Float?
  lng          Float?
  verified     Int      @default(0)
  active       Int      @default(1)
  adminHash    String   @map("admin_hash")
  clerkUserId  String?  @map("clerk_user_id")
  verificationBadge String? @map("verification_badge")
  verificationNotes  String? @map("verification_notes")
  verifiedAt   DateTime? @map("verified_at")
  verifiedBy   String?  @map("verified_by")
  createdAt    DateTime @default(now()) @map("created_at")

  @@map("organizations")
}

model AgencyAccount {
  id             Int       @id @default(autoincrement())
  organizationId Int       @map("organization_id")
  email          String    @unique
  passwordHash   String     @map("password_hash")
  displayName    String     @map("display_name")
  role           String     @default("admin")
  active         Int       @default(1)
  lastLoginAt    DateTime?  @map("last_login_at")
  clerkUserId    String?   @map("clerk_user_id")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @default(now()) @map("updated_at")

  @@map("agency_accounts")
}

model PlatformUser {
  id             Int      @id @default(autoincrement())
  clerkUserId    String   @unique @map("clerk_user_id")
  email          String
  displayName    String?  @map("display_name")
  avatarUrl      String?  @map("avatar_url")
  role           String   @default("user")
  isAdmin        Boolean  @default(false) @map("is_admin")
  isOrgAdmin     Boolean  @default(false) @map("is_org_admin")
  organizationId Int?     @map("organization_id")
  // IP tracking
  lastIpHash     String?  @map("last_ip_hash")
  lastIpRegion   String?  @map("last_ip_region")
  lastIpCity     String?  @map("last_ip_city")
  // Geo hierarchy
  state          String?
  lga            String?
  community      String?
  village        String?
  region         String?
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @default(now()) @map("updated_at")

  @@map("platform_users")
}

model OrgMember {
  id             Int      @id @default(autoincrement())
  organizationId Int      @map("organization_id")
  clerkUserId    String   @map("clerk_user_id")
  email          String
  displayName    String    @map("display_name")
  role           String    @default("member")
  permissions    Json     @default("[]")
  active         Int      @default(1)
  invitedBy      String?  @map("invited_by")
  invitedAt      DateTime @default(now()) @map("invited_at")
  joinedAt       DateTime? @map("joined_at")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @default(now()) @map("updated_at")

  @@unique([organizationId, clerkUserId], name: "idx_org_members_org_clerk")
  @@map("org_members")
}

model Vacancy {
  id                 Int       @id @default(autoincrement())
  organizationId     Int       @map("organization_id")
  title              String
  description        String
  category           String    @default("general")
  location          String?
  employmentType     String     @default("full-time") @map("employment_type")
  salaryRange        String?   @map("salary_range")
  requirements       Json      @default("[]")
  responsibilities   Json      @default("[]")
  status             String    @default("open")
  applicationDeadline DateTime? @map("application_deadline")
  postedByClerkId    String     @map("posted_by_clerk_id")
  createdAt          DateTime  @default(now()) @map("created_at")
  updatedAt          DateTime  @default(now()) @map("updated_at")

  @@map("vacancies")
}

model VacancyApplication {
  id            Int      @id @default(autoincrement())
  vacancyId     Int      @map("vacancy_id")
  clerkUserId   String?  @map("clerk_user_id")
  applicantName String   @map("applicant_name")
  applicantEmail String  @map("applicant_email")
  coverLetter   String?  @map("cover_letter")
  resumeUrl     String?  @map("resume_url")
  status        String   @default("pending")
  createdAt     DateTime @default(now()) @map("created_at")

  @@map("vacancy_applications")
}

// ─── Sync / Mesh ───

model SyncQueue {
  id                 Int       @id @default(autoincrement())
  deviceHash         String    @map("device_hash")
  operation          String
  payload            String
  status             String    @default("pending")
  conflictResolution String?   @map("conflict_resolution")
  bundleId           String?   @map("bundle_id")
  createdAt          DateTime  @default(now()) @map("created_at")
  syncedAt           DateTime?  @map("synced_at")

  @@map("sync_queue")
}

model MeshEvent {
  id          Int      @id @default(autoincrement())
  bundleId    String   @map("bundle_id")
  deviceHash  String   @map("device_hash")
  event       String
  recordCount Int      @default(0) @map("record_count")
  metadata    String   @default("{}")
  createdAt   DateTime @default(now()) @map("created_at")

  @@map("mesh_events")
}

model PushSubscription {
  id            Int      @id @default(autoincrement())
  deviceHash    String   @map("device_hash")
  endpoint      String
  p256dh        String
  auth          String
  categories    String   @default("[]")
  neighborhoods String   @default("[]")
  active        Int      @default(1)
  createdAt     DateTime @default(now()) @map("created_at")

  @@map("push_subscriptions")
}

model Achievement {
  id         Int      @id @default(autoincrement())
  deviceHash String   @map("device_hash")
  achievement String
  tier       String   @default("bronze")
  xpAwarded  Int      @default(0) @map("xp_awarded")
  createdAt  DateTime @default(now()) @map("created_at")

  @@map("achievements")
}

model UserStat {
  id                Int      @id @default(autoincrement())
  deviceHash        String   @unique @map("device_hash")
  xp               Int      @default(0)
  level            Int      @default(1)
  currentStreak     Int      @default(0) @map("current_streak")
  longestStreak     Int      @default(0) @map("longest_streak")
  lastReportDate    String?  @map("last_report_date")
  totalReports      Int      @default(0) @map("total_reports")
  totalVerifications Int     @default(0) @map("total_verifications")
  badges           String   @default("[]")
  updatedAt        DateTime @default(now()) @map("updated_at")

  @@map("user_stats")
}

model GeoCluster {
  id             Int      @id @default(autoincrement())
  geoHash        String   @map("geo_hash")
  neighborhoodId Int?     @map("neighborhood_id")
  clusterType    String   @map("cluster_type")
  reportCount    Int      @default(0) @map("report_count")
  avgTrustScore  Int      @default(50) @map("avg_trust_score")
  centroidLat    Float    @map("centroid_lat")
  centroidLng    Float    @map("centroid_lng")
  radiusMeters   Int      @default(500) @map("radius_meters")
  lastReportAt   DateTime @default(now()) @map("last_report_at")
  createdAt      DateTime @default(now()) @map("created_at")

  @@map("geo_clusters")
}

model ModelRun {
  id           Int      @id @default(autoincrement())
  modelName    String   @map("model_name")
  modelVersion String   @map("model_version")
  inputType    String   @map("input_type")
  inputId      Int?
  output       String   @default("{}")
  confidence   Float    @default(0.5)
  explanation  String?
  executionMs  Int      @default(0) @map("execution_ms")
  createdAt    DateTime @default(now()) @map("created_at")

  @@map("model_runs")
}

// ─── AI / Analytics Tables ───

model UserBrowsingEvent {
  id             Int      @id @default(autoincrement())
  clerkUserId    String?  @map("clerk_user_id")
  userHash       String?  @map("user_hash")
  eventType      String   @map("event_type")
  truthId        Int?     @map("truth_id")
  neighborhoodId Int?     @map("neighborhood_id")
  category       String?
  path           String?
  metadata       Json     @default("{}")
  dwellMs        Int      @default(0) @map("dwell_ms")
  createdAt      DateTime @default(now()) @map("created_at")

  @@map("user_browsing_events")
}

model PostSuggestion {
  id           Int       @id @default(autoincrement())
  clerkUserId  String?   @map("clerk_user_id")
  userHash     String?   @map("user_hash")
  truthId      Int       @map("truth_id")
  score        Float     @default(0.5)
  reason       String?
  sourceModel  String    @default("heuristic") @map("source_model")
  clicked      Int       @default(0)
  dismissed    Int       @default(0)
  createdAt    DateTime  @default(now()) @map("created_at")
  expiresAt    DateTime? @map("expires_at")

  @@map("post_suggestions")
}

model WeeklyUserReview {
  id              Int      @id @default(autoincrement())
  weekStart       DateTime @map("week_start")
  weekEnd         DateTime @map("week_end")
  clerkUserId     String?  @map("clerk_user_id")
  userHash        String?  @map("user_hash")
  email           String?
  displayName     String?  @map("display_name")
  metrics         Json     @default("{}")
  summary         String?
  recommendations Json     @default("[]")
  riskFlags       Json     @default("[]") @map("risk_flags")
  aiSummary       String?  @map("ai_summary")
  modelVersion    String   @default("heuristic") @map("model_version")
  generatedAt     DateTime @default(now()) @map("generated_at")

  @@unique([weekStart, clerkUserId])
  @@map("weekly_user_reviews")
}

// ─── News System ───

model NewsArticle {
  id              Int       @id @default(autoincrement())
  title           String    @db.VarChar(300)
  slug            String    @unique
  excerpt         String?    @db.Text
  content         String    @db.Text
  coverImageUrl   String?   @map("cover_image_url")
  mediaUrls       String    @default("[]") @map("media_urls") // JSON array
  category        String    @default("general")
  tags            String    @default("[]") // JSON array
  authorId        Int?      @map("author_id")
  authorName      String    @map("author_name")
  authorType      String    @default("agency") @map("author_type") // agency | user | admin
  organizationId  Int?      @map("organization_id")
  state           String?
  lga             String?
  status          String    @default("draft") // draft | pending_review | published | rejected | archived
  isVerified      Boolean   @default(false) @map("is_verified")
  verificationBadge String? @map("verification_badge")
  trustScore      Int       @default(50) @map("trust_score")
  viewCount       Int       @default(0) @map("view_count")
  likeCount       Int       @default(0) @map("like_count")
  commentCount    Int       @default(0) @map("comment_count")
  accuracyBonus   Int       @default(0) @map("accuracy_bonus")
  publishedAt     DateTime? @map("published_at")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @default(now()) @map("updated_at")

  @@index([status])
  @@index([category])
  @@index([organizationId])
  @@map("news_articles")
}

model NewsComment {
  id              Int       @id @default(autoincrement())
  articleId       Int       @map("article_id")
  userHash        String    @map("user_hash")
  authorName      String    @map("author_name")
  authorAvatar    String?   @map("author_avatar")
  content         String    @db.Text // Rich text HTML
  imageUrl        String?   @map("image_url")
  stickerId       String?   @map("sticker_id")
  giftId          String?   @map("gift_id")
  parentCommentId Int?      @map("parent_comment_id")
  likeCount       Int       @default(0) @map("like_count")
  replyCount      Int       @default(0) @map("reply_count")
  status          String    @default("active")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @default(now()) @map("updated_at")

  @@index([articleId])
  @@index([userHash])
  @@map("news_comments")
}

model NewsLike {
  id         Int      @id @default(autoincrement())
  articleId  Int      @map("article_id")
  userHash   String   @map("user_hash")
  createdAt  DateTime @default(now()) @map("created_at")

  @@unique([articleId, userHash])
  @@map("news_likes")
}

model CommentLike {
  id         Int      @id @default(autoincrement())
  commentId  Int      @map("comment_id")
  userHash   String   @map("user_hash")
  articleId  Int      @map("article_id")
  createdAt  DateTime @default(now()) @map("created_at")

  @@unique([commentId, userHash])
  @@map("comment_likes")
}

// ─── Rewards System ───

model RewardCategory {
  id          Int      @id @default(autoincrement())
  name        String   @unique
  description String?
  icon        String?
  active      Boolean  @default(true)
  createdAt   DateTime @default(now()) @map("created_at")

  @@map("reward_categories")
}

model RewardRedemption {
  id              Int       @id @default(autoincrement())
  userHash        String    @map("user_hash")
  rewardType      String    @map("reward_type") // airtime | data | giftcard | voucher | cash
  rewardCategory  String    @map("reward_category")
  amount          Int
  status          String    @default("pending") // pending | approved | denied | fulfilled | failed
  description     String
  recipientPhone  String?   @map("recipient_phone")
  recipientName   String?   @map("recipient_name")
  networkProvider String?   @map("network_provider")
  giftCardCode    String?   @map("gift_card_code")
  voucherStoreName String? @map("voucher_store_name")
  voucherCode     String?   @map("voucher_code")
  adminNotes      String?   @map("admin_notes")
  processedBy     String?   @map("processed_by")
  processedAt     DateTime? @map("processed_at")
  createdAt       DateTime  @default(now()) @map("created_at")

  @@index([userHash])
  @@index([status])
  @@map("reward_redemptions")
}

model GiftCard {
  id            Int       @id @default(autoincrement())
  code          String    @unique
  type          String    // airtime | data | shopping | voucher
  brand         String
  faceValue     Int       @map("face_value")
  balance       Int       @default(0)
  currency      String    @default("NGN")
  expiryDate    DateTime  @map("expiry_date")
  status        String    @default("active") // active | redeemed | expired | revoked
  redeemedBy    String?   @map("redeemed_by")
  redeemedAt    DateTime? @map("redeemed_at")
  createdBy     String    @map("created_by")
  metadata      String    @default("{}")
  createdAt     DateTime  @default(now()) @map("created_at")

  @@index([status])
  @@index([type])
  @@map("gift_cards")
}

model StoreVoucher {
  id            Int       @id @default(autoincrement())
  code          String    @unique
  storeName     String    @map("store_name")
  storeType     String    @default("general") @map("store_type")
  description   String?
  discountType  String    @default("fixed") @map("discount_type") // fixed | percentage
  discountValue Int       @map("discount_value")
  minPurchase   Int       @default(0) @map("min_purchase")
  maxDiscount   Int?      @map("max_discount")
  validFrom     DateTime  @map("valid_from")
  validUntil    DateTime  @map("valid_until")
  status        String    @default("active") // active | used | expired | revoked
  usedBy        String?   @map("used_by")
  usedAt        DateTime? @map("used_at")
  partnerBusiness String? @map("partner_business")
  createdAt     DateTime  @default(now()) @map("created_at")

  @@index([storeName])
  @@index([status])
  @@map("store_vouchers")
}

model TelecomTransaction {
  id              Int       @id @default(autoincrement())
  userHash        String    @map("user_hash")
  phoneNumber     String    @map("phone_number")
  networkProvider String    @map("network_provider") // MTN | Airtel | Glo | 9mobile
  serviceType     String    @map("service_type") // airtime | data
  amount          Int
  planCode        String?   @map("plan_code")
  planName        String?   @map("plan_name")
  status          String    @default("pending") // pending | success | failed | retry
  providerRef     String?   @map("provider_ref")
  provider        String?   // vtpass | africastalking | termii | infobip
  errorMessage    String?   @map("error_message")
  retryCount      Int       @default(0) @map("retry_count")
  ledgerEntryId   Int?      @map("ledger_entry_id")
  redemptionId    Int?      @map("redemption_id")
  processedAt     DateTime? @map("processed_at")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @default(now()) @map("updated_at")

  @@index([userHash])
  @@index([status])
  @@index([phoneNumber])
  @@map("telecom_transactions")
}

model AuditLog {
  id          Int      @id @default(autoincrement())
  actorId     String   @map("actor_id")
  actorName   String    @map("actor_name")
  actorRole   String    @map("actor_role")
  action      String
  entityType  String   @map("entity_type") // reward | news | telecom | user | giftcard | voucher
  entityId    Int?     @map("entity_id")
  description String
  oldValues   String?  @map("old_values") // JSON
  newValues   String?  @map("new_values") // JSON
  ipAddress   String?  @map("ip_address")
  createdAt   DateTime @default(now()) @map("created_at")

  @@index([entityType])
  @@index([actorId])
  @@map("audit_logs")
}

// ─── Questionnaire System ───

model Questionnaire {
  id          Int       @id @default(autoincrement())
  title       String
  description String?
  questions   String   @default("[]") // JSON array of question objects
  status      String   @default("active") // active | inactive
  createdBy   String   @map("created_by")
  expiresAt   DateTime? @map("expires_at")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @default(now()) @map("updated_at")

  @@index([expiresAt])
  @@map("questionnaires")
}

// ─── Feedback Schedule ───

model FeedbackSchedule {
  id              Int       @id @default(autoincrement())
  userHash        String    @map("user_hash")
  clerkUserId     String?   @map("clerk_user_id")
  signupDate      DateTime  @map("signup_date")
  firstPromptShown Boolean  @default(false) @map("first_prompt_shown")
  firstPromptDate DateTime? @map("first_prompt_date")
  lastPromptDate  DateTime? @map("last_prompt_date")
  nextPromptDate  DateTime? @map("next_prompt_date")
  feedbackCount   Int       @default(0) @map("feedback_count")
  createdAt       DateTime  @default(now()) @map("created_at")

  @@unique([userHash])
  @@map("feedback_schedules")
}

// ─── News Accuracy Incentives ───

model NewsIncentive {
  id          Int      @id @default(autoincrement())
  articleId   Int      @map("article_id")
  userHash    String   @map("user_hash")
  incentiveType String @map("incentive_type") // credit | badge | trust_boost
  amount      Int      @default(0)
  badgeName   String?  @map("badge_name")
  trustBoost  Int      @default(0) @map("trust_boost")
  reason      String?
  createdAt   DateTime @default(now()) @map("created_at")

  @@index([articleId])
  @@index([userHash])
  @@map("news_incentives")
}

// ─── Nigeria Electoral Geography (INEC) ───

model Ward {
  id              Int      @id @default(autoincrement())
  code            String
  name            String
  lgaId           Int      @map("lga_id")
  stateId         Int      @map("state_id")
  portalId        Int?     @map("portal_id")
  lat             Float?
  lng             Float?
  source          String?
  sourceUpdatedAt DateTime? @map("source_updated_at")
  createdAt       DateTime @default(now()) @map("created_at")

  lga             Lga      @relation(fields: [lgaId], references: [id])
  state           State    @relation(fields: [stateId], references: [id])
  microTruths     MicroTruth[]

  @@unique([lgaId, code, name], name: "idx_wards_unique_lga_code_name")
  @@index([lgaId])
  @@index([stateId])
  @@index([code])
  @@map("wards")
}

// ─── Politics: normalized canonical model ───

model PoliticalPosition {
  id        Int      @id @default(autoincrement())
  code      String   @unique
  name      String
  level     String   @default("federal")
  sortOrder Int      @default(99) @map("sort_order")
  createdAt DateTime @default(now()) @map("created_at")

  officeHolders     OfficeHolder[]
  electionCandidates ElectionCandidate[]

  @@index([level])
  @@map("political_positions")
}

model PoliticalPerson {
  id                       Int       @id @default(autoincrement())
  slug                     String    @unique
  fullName                 String    @map("full_name")
  photoUrl                 String?   @map("photo_url")
  gender                   String?
  dateOfBirth              String?   @map("date_of_birth")
  placeOfBirth             String?   @map("place_of_birth")
  hometown                 String?
  nationality              String    @default("Nigerian")
  stateOfOrigin            String?   @map("state_of_origin")
  localGovtOfOrigin        String?   @map("local_govt_of_origin")
  autobiography            String?
  educationBackground      String?   @map("education_background")
  previousPoliticalPositions String? @map("previous_political_positions")
  politicalBackground      String?   @map("political_background")
  businesses               String?
  businessInterests        String?   @map("business_interests")
  netWorth                 String?   @map("net_worth")
  assetsDeclared           String?   @map("assets_declared")
  healthStatus             String?   @map("health_status")
  healthDisclosureUrl      String?   @map("health_disclosure_url")
  phone                    String?
  email                    String?
  website                  String?
  facebook                 String?
  twitter                  String?
  instagram                String?
  linkedin                 String?
  sourceUrls               String?   @map("source_urls")
  verificationStatus       String    @default("unverified") @map("verification_status")
  dataConfidence           Int       @default(0) @map("data_confidence")
  createdAt                DateTime  @default(now()) @map("created_at")
  updatedAt                DateTime  @default(now()) @map("updated_at")

  officeHolders      OfficeHolder[]
  electionCandidates ElectionCandidate[]

  @@index([stateOfOrigin])
  @@index([verificationStatus])
  @@map("political_persons")
}

model PoliticalElection {
  id          Int       @id @default(autoincrement())
  year        Int
  name        String
  type        String    @default("general")
  geoScope    String    @default("national") @map("geo_scope")
  electionDate DateTime? @map("election_date")
  status      String    @default("upcoming")
  createdAt   DateTime  @default(now()) @map("created_at")

  officeHolders      OfficeHolder[]
  electionCandidates ElectionCandidate[]

  @@unique([year, type, geoScope], name: "idx_elections_unique")
  @@index([year])
  @@map("political_elections")
}

model OfficeHolder {
  id                  Int      @id @default(autoincrement())
  personId            Int      @map("person_id")
  positionId          Int      @map("position_id")
  partyAcronym        String?  @map("party_acronym")
  electionId          Int?     @map("election_id")
  stateId             Int?     @map("state_id")
  lgaId               Int?     @map("lga_id")
  wardId              Int?     @map("ward_id")
  senatorialDistrict  String?  @map("senatorial_district")
  federalConstituency String?  @map("federal_constituency")
  stateConstituency   String?  @map("state_constituency")
  termStart           String?  @map("term_start")
  termEnd             String?  @map("term_end")
  incumbentSince      String?  @map("incumbent_since")
  status              String   @default("active")
  sourceUrls          String?  @map("source_urls")
  verificationStatus  String   @default("unverified") @map("verification_status")
  dataConfidence      Int      @default(0) @map("data_confidence")
  createdAt           DateTime @default(now()) @map("created_at")
  updatedAt           DateTime @default(now()) @map("updated_at")

  person     PoliticalPerson     @relation(fields: [personId], references: [id])
  position   PoliticalPosition   @relation(fields: [positionId], references: [id])
  election   PoliticalElection? @relation(fields: [electionId], references: [id])

  @@index([positionId])
  @@index([stateId, lgaId, wardId])
  @@index([partyAcronym])
  @@map("office_holders")
}

model ElectionCandidate {
  id                  Int      @id @default(autoincrement())
  personId            Int      @map("person_id")
  positionId          Int      @map("position_id")
  electionId          Int      @map("election_id")
  partyAcronym        String?  @map("party_acronym")
  stateId             Int?     @map("state_id")
  lgaId               Int?     @map("lga_id")
  wardId              Int?     @map("ward_id")
  senatorialDistrict  String?  @map("senatorial_district")
  federalConstituency String?  @map("federal_constituency")
  stateConstituency   String?  @map("state_constituency")
  manifesto           String?
  manifestoSummary    String?  @map("manifesto_summary")
  campaignSlogan      String?  @map("campaign_slogan")
  keyPolicies         String?  @map("key_policies")
  runningMate         String?  @map("running_mate")
  recordType          String   @default("candidate") @map("record_type")
  status              String   @default("pending")
  sourceUrls          String?  @map("source_urls")
  verificationStatus  String   @default("unverified") @map("verification_status")
  dataConfidence      Int      @default(0) @map("data_confidence")
  createdAt           DateTime @default(now()) @map("created_at")
  updatedAt           DateTime @default(now()) @map("updated_at")

  person    PoliticalPerson   @relation(fields: [personId], references: [id])
  position  PoliticalPosition @relation(fields: [positionId], references: [id])
  election PoliticalElection @relation(fields: [electionId], references: [id])

  @@index([partyAcronym])
  @@index([positionId])
  @@index([electionId])
  @@index([stateId, lgaId, wardId])
  @@map("election_candidates")
}

// ─── Community Feeds Trending Cache ───

model FeedTrending {
  id              Int      @id @default(autoincrement())
  geoLevel        String   @map("geo_level")
  geoId           Int?     @map("geo_id")
  geoName         String?  @map("geo_name")
  category        String
  tag             String?
  postCount       Int      @default(0) @map("post_count")
  totalLikes      Int      @default(0) @map("total_likes")
  totalComments    Int      @default(0) @map("total_comments")
  totalVerifications Int   @default(0) @map("total_verifications")
  trendingScore   Float    @default(0.0) @map("trending_score")
  periodStart     DateTime @map("period_start")
  periodEnd       DateTime @map("period_end")
  computedAt      DateTime @default(now()) @map("computed_at")

  @@index([geoLevel, geoId, computedAt])
  @@index([geoLevel, geoName, computedAt])
  @@map("feed_trending")
}

// ─── Super Admin: Sub-Admin Management ───

model AdminRole {
  id          Int      @id @default(autoincrement())
  name        String   @unique
  description String?
  permissions String   @default("[]")
  isSystem    Boolean  @default(false) @map("is_system")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @default(now()) @map("updated_at")

  adminUsers     AdminUser[]
  assignments   AdminAssignment[]

  @@index([name])
  @@map("admin_roles")
}

model AdminUser {
  id           Int       @id @default(autoincrement())
  clerkUserId  String?   @unique @map("clerk_user_id")
  email        String
  displayName  String?   @map("display_name")
  avatarUrl    String?   @map("avatar_url")
  roleId       Int?      @map("role_id")
  role         AdminRole? @relation(fields: [roleId], references: [id])
  status       String    @default("active")
  invitedBy    String?   @map("invited_by")
  lastLoginAt  DateTime? @map("last_login_at")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @default(now()) @map("updated_at")

  assignments AdminAssignment[]

  @@index([email])
  @@index([clerkUserId])
  @@index([status])
  @@map("admin_users")
}

model AdminAssignment {
  id              Int       @id @default(autoincrement())
  adminUserId     Int       @map("admin_user_id")
  roleId          Int       @map("role_id")
  scope           String    @default("global")
  scopeEntityType String?   @map("scope_entity_type")
  scopeEntityId   Int?      @map("scope_entity_id")
  assignedBy      String?   @map("assigned_by")
  assignedAt      DateTime  @default(now()) @map("assigned_at")
  revokedAt       DateTime? @map("revoked_at")
  status          String    @default("active")

  adminUser AdminUser  @relation(fields: [adminUserId], references: [id], onDelete: Cascade)
  role      AdminRole @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@unique([adminUserId, roleId, scope, scopeEntityType, scopeEntityId])
  @@index([adminUserId])
  @@index([roleId])
  @@index([status])
  @@map("admin_assignments")
}

// ─── NewsAPI External News ───

model NewsExternal {
  id                Int       @id @default(autoincrement())
  sourceName        String?   @map("source_name")
  author            String?
  title             String
  description       String?
  content           String?
  url               String    @unique
  imageUrl          String?   @map("image_url")
  publishedAt       DateTime? @map("published_at")
  category          String    @default("general")
  createdAt         DateTime  @default(now()) @map("created_at")
  isAudioGenerated  Boolean   @default(false) @map("is_audio_generated")
  audioUrl          String?   @map("audio_url")

  @@index([category])
  @@index([publishedAt])
  @@index([sourceName])
  @@map("news_external")
}

// ─── Community Feed Engagement (likes/dislikes/reposts/gifts) ───

model FeedDislike {
  id        Int      @id @default(autoincrement())
  truthId   Int      @map("truth_id")
  userHash  String   @map("user_hash")
  createdAt DateTime @default(now()) @map("created_at")

  @@unique([truthId, userHash])
  @@index([truthId])
  @@index([userHash])
  @@map("feed_dislikes")
}

model FeedRepost {
  id        Int      @id @default(autoincrement())
  truthId   Int      @map("truth_id")
  userHash  String   @map("user_hash")
  createdAt DateTime @default(now()) @map("created_at")

  @@unique([truthId, userHash])
  @@index([truthId])
  @@index([userHash])
  @@map("feed_reposts")
}

model TruthGift {
  id            Int      @id @default(autoincrement())
  truthId       Int      @map("truth_id")
  senderHash    String   @map("sender_hash")
  recipientHash String   @map("recipient_hash")
  giftId        String   @map("gift_id")
  points        Int      @default(1)
  createdAt     DateTime @default(now()) @map("created_at")

  @@index([truthId])
  @@index([recipientHash])
  @@map("truth_gifts")
}
