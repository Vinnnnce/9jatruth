# ─── Application ───────────────────────────────────────────
NODE_ENV=development
PORT=3000
APP_NAME=9jatruth
APP_URL=http://localhost:3000
API_PREFIX=api/v1

# ─── Database (Neon Postgres) ───────────────────────────
# Replace with your actual Neon connection string from https://console.neon.tech
DATABASE_URL=postgresql://USER:PASSWORD@ep-XXXX-XXXX-XXXX.neon.tech/DB_NAME?sslmode=require

# Neon pooler connection (for serverless / high-connection scenarios)
# DATABASE_URL=postgresql://USER:PASSWORD@ep-XXXX-XXXX-XXXX-pooler.neon.tech/DB_NAME?sslmode=require

# ─── JWT ──────────────────────────────────────────────────
JWT_ACCESS_SECRET=super-secret-access-key-change-in-production
JWT_REFRESH_SECRET=super-secret-refresh-key-change-in-production
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# ─── Redis / Cache ────────────────────────────────────────
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
CACHE_TTL=300

# ─── Throttle ─────────────────────────────────────────────
THROTTLE_TTL=60
THROTTLE_LIMIT=100

# ─── News API ────────────────────────────────────────────
NEWS_API_KEY=your-newsapi-key
NEWS_API_URL=https://newsapi.org/v2
NEWS_API_COUNTRY=ng
NEWS_FETCH_CRON=0 */2 * * *

# ─── Upload / S3 ──────────────────────────────────────────
UPLOAD_DIR=./uploads
S3_ENDPOINT=
S3_REGION=us-east-1
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=true

# ─── Logging ──────────────────────────────────────────────
LOG_LEVEL=info
