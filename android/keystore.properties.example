# Copy this file to keystore.properties and fill in your values.
# DO NOT commit keystore.properties or the .jks file to the repository.
#
# Generate a keystore with:
#   keytool -genkeypair \
#     -alias 9jatruth-key \
#     -keyalg RSA -keysize 2048 -validity 3650 \
#     -keystore 9jatruth-release.jks
#
# For CI/CD, set these as environment variables instead:
#   KEYSTORE_PATH, KEYSTORE_PASSWORD, KEY_ALIAS, KEY_PASSWORD

storeFile=9jatruth-release.jks
storePassword=your-keystore-password
keyAlias=9jatruth-key
keyPassword=your-key-password
