# ═══════════════════════════════════════════════════════════
# 9jatruth Monorepo Environment Variables
# ═══════════════════════════════════════════════════════════

# ─── PostgreSQL ──────────────────────────────────────────────
POSTGRES_DB=9jatruth
POSTGRES_USER=9jatruth
POSTGRES_PASSWORD=change_me_in_production

# ─── Backend (Neon Postgres) ───────────────────────────────
# Replace with your actual Neon connection string from https://console.neon.tech
DATABASE_URL=postgresql://9jatruth:change_me_in_production@ep-XXXX-XXXX-XXXX.neon.tech/9jatruth?sslmode=require
REDIS_URL=redis://localhost:6379

# JWT
JWT_ACCESS_SECRET=change_me_access_secret_min_32_chars
JWT_REFRESH_SECRET=change_me_refresh_secret_min_32_chars
JWT_ACCESS_EXPIRES_IN=900
JWT_REFRESH_EXPIRES_IN=604800

# S3 / MinIO
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=minio
S3_SECRET_KEY=change_me_in_production
S3_BUCKET=9jatruth-uploads
S3_REGION=us-east-1

# News API
NEWS_API_KEY=your_newsapi_key_here

# ─── Clerk Authentication ────────────────────────────────────
# Get these from https://dashboard.clerk.com/last-active
# NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY must start with pk_live_ or pk_test_
# CLERK_SECRET_KEY must start with sk_live_ or sk_test_
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_live_your_clerk_publishable_key
CLERK_SECRET_KEY=sk_live_your_clerk_secret_key
# Optional: Clerk webhook secret for user sync (from Clerk Dashboard → Webhooks)
CLERK_WEBHOOK_SECRET=whsec_your_webhook_secret

# Cron job secret (used to protect /api/cron/* and /api/news/fetch-external endpoints)
CRON_SECRET=your_cron_secret_here

# Server
PORT=3001
NODE_ENV=development

# ─── Admin Dashboard ─────────────────────────────────────────
VITE_API_URL=http://localhost:3001

# ─── MinIO ───────────────────────────────────────────────────
MINIO_ROOT_USER=minio
MINIO_ROOT_PASSWORD=change_me_in_production
