# ─── Neon PostgreSQL (Required for Vercel deployment) ───
DATABASE_URL=postgresql://user:password@ep-xxx.neon.tech/dbname?sslmode=require

# ─── Clerk Authentication ───
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_live_Y2xlcmsuOWphdHJ1dGguY29tJA
CLERK_SECRET_KEY=sk_live_replace_in_vercel_env
CLERK_JWKS_URL=https://your-clerk-instance.clerk.accounts.dev/.well-known/jwks.json

# Clerk webhook secret (for syncing users to DB)
CLERK_WEBHOOK_SECRET=whsec_replace_with_your_key

# ─── App URLs ───
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ─── Referral base URL ───
# Canonical referral domain. Super-admin can also override this live from the
# dashboard (SiteConfig.referral_base_url); the value below is the fallback.
# Never set this to the vercel.app preview domain in production.
NEXT_PUBLIC_REFERRAL_BASE_URL=https://9jatruth.com
# Legacy host-only override (optional):
# NEXT_PUBLIC_REFERRAL_DOMAIN=9jatruth.com

# Clerk: add 9jatruth.com (and any custom subdomains) to Allowed Origins in the
# Clerk dashboard → Domains. Also set the production URL to https://9jatruth.com.

# ─── JWT Secret (for legacy agency auth — being replaced by Clerk) ───
JWT_SECRET=your-jwt-secret-key

# ─── Push Notifications (Web Push / VAPID) ───
VAPID_PUBLIC_KEY=replace_with_your_vapid_public_key
VAPID_PRIVATE_KEY=replace_with_your_vapid_private_key
VAPID_SUBJECT=mailto:9jatruthofficial@gmail.com

# ─── Super Admin ───
SUPER_ADMIN_EMAIL=9jatruthofficial@gmail.com

# ─── Kimi K3 AI (Moonshot AI) ───
KIMI_API_KEY=replace_with_your_kimi_key
KIMI_MODEL=kimi-k3
KIMI_BASE_URL=https://api.moonshot.ai/v1

# ─── Deepseek AI (primary AI provider — works together with Kimi K3) ───
# Deepseek handles the AI aspects of the website. When configured it is tried
# first; Kimi K3 is used as an automatic fallback. Get a key at
# https://platform.deepseek.com. Treat this key as a secret — rotate it if it
# is ever exposed in chat or committed to git.
DEEPSEEK_API_KEY=replace_with_your_deepseek_key
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1

# ─── MapTiler (satellite hybrid map + 3D terrain) ───
NEXT_PUBLIC_MAPTILER_API_KEY=replace_with_your_maptiler_key

# ─── Telecom Integration (Nigerian airtime/data top-ups) ───
VTPASS_API_KEY=replace_with_your_vtpass_api_key
VTPASS_PUBLIC_KEY=replace_with_your_vtpass_public_key
VTPASS_SECRET_KEY=replace_with_your_vtpass_secret_key
VTPASS_SANDBOX=true

# Africa's Talking (fallback provider)
AFRICAS_TALKING_API_KEY=replace_with_your_africas_talking_key
AFRICAS_TALKING_USERNAME=sandbox

# ─── iOS App Download ───
NEXT_PUBLIC_IOS_APP_URL=https://apps.apple.com/app/9jatruth

# ─── Media Upload ───
UPLOAD_DIR=public/uploads

# ─── Cron / Automated Summary ───
CRON_SECRET=replace_with_your_cron_secret

# ─── senseEDGE Geo Intelligence ───
SENSEEDGE_ENABLED=true

# ─── NewsAPI.org (External Nigerian News) ───
NEWS_API_KEY=replace_with_your_newsapi_key

# ─── Clerk Google OAuth ───
# Enable Google OAuth in Clerk Dashboard → User & Authentication → Social Connections → Google
# The SignIn/SignUp components already support Google login via Clerk's built-in UI.
# No additional env vars needed - Google OAuth is configured in the Clerk dashboard.
# Ensure 9jatruth.com is added to Clerk's Allowed Origins (Domains page).
# Set production URL to https://9jatruth.com in Clerk dashboard.
