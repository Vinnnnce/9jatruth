# ─── Neon PostgreSQL (Required for Vercel deployment) ───
DATABASE_URL=postgresql://user:password@ep-xxx.neon.tech/dbname?sslmode=require

# ─── Clerk Authentication ───
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_replace_with_your_key
CLERK_SECRET_KEY=sk_test_replace_with_your_key
CLERK_JWKS_URL=https://your-clerk-instance.clerk.accounts.dev/.well-known/jwks.json

# Clerk webhook secret (for syncing users to DB)
CLERK_WEBHOOK_SECRET=whsec_replace_with_your_key

# ─── App URLs ───
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ─── JWT Secret (for legacy agency auth — being replaced by Clerk) ───
JWT_SECRET=your-jwt-secret-key

# ─── Push Notifications (Web Push / VAPID) ───
VAPID_PUBLIC_KEY=replace_with_your_vapid_public_key
VAPID_PRIVATE_KEY=replace_with_your_vapid_private_key
VAPID_SUBJECT=mailto:9jatruthofficial@gmail.com

# ─── Super Admin ───
SUPER_ADMIN_EMAIL=9jatruthofficial@gmail.com

# ─── Kimi K3 AI (Moonshot AI) ───
KIMI_API_KEY=replace_with_your_kimi_key
KIMI_MODEL=kimi-k3
KIMI_BASE_URL=https://api.moonshot.ai/v1

# ─── MapTiler (satellite hybrid map + 3D terrain) ───
NEXT_PUBLIC_MAPTILER_API_KEY=replace_with_your_maptiler_key

# ─── Telecom Integration (Nigerian airtime/data top-ups) ───
VTPASS_API_KEY=replace_with_your_vtpass_api_key
VTPASS_PUBLIC_KEY=replace_with_your_vtpass_public_key
VTPASS_SECRET_KEY=replace_with_your_vtpass_secret_key
VTPASS_SANDBOX=true

# Africa's Talking (fallback provider)
AFRICAS_TALKING_API_KEY=replace_with_your_africas_talking_key
AFRICAS_TALKING_USERNAME=sandbox

# ─── iOS App Download ───
NEXT_PUBLIC_IOS_APP_URL=https://apps.apple.com/app/9jatruth

# ─── Media Upload ───
UPLOAD_DIR=public/uploads

# ─── Cron / Automated Summary ───
CRON_SECRET=replace_with_your_cron_secret

# ─── senseEDGE Geo Intelligence ───
SENSEEDGE_ENABLED=true
