# ═══════════════════════════════════════════════════════════
# 9jatruth Monorepo Environment Variables
# ═══════════════════════════════════════════════════════════

# ─── PostgreSQL ──────────────────────────────────────────────
POSTGRES_DB=9jatruth
POSTGRES_USER=9jatruth
POSTGRES_PASSWORD=change_me_in_production

# ─── Backend ─────────────────────────────────────────────────
DATABASE_URL=postgresql://9jatruth:change_me_in_production@localhost:5432/9jatruth?schema=public
REDIS_URL=redis://localhost:6379

# JWT
JWT_ACCESS_SECRET=change_me_access_secret_min_32_chars
JWT_REFRESH_SECRET=change_me_refresh_secret_min_32_chars
JWT_ACCESS_EXPIRES_IN=900
JWT_REFRESH_EXPIRES_IN=604800

# S3 / MinIO
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=minio
S3_SECRET_KEY=change_me_in_production
S3_BUCKET=9jatruth-uploads
S3_REGION=us-east-1

# News API
NEWS_API_KEY=your_newsapi_key_here

# Server
PORT=3001
NODE_ENV=development

# ─── Admin Dashboard ─────────────────────────────────────────
VITE_API_URL=http://localhost:3001

# ─── MinIO ───────────────────────────────────────────────────
MINIO_ROOT_USER=minio
MINIO_ROOT_PASSWORD=change_me_in_production
