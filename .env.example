# ─── Neon PostgreSQL (Required for Vercel deployment) ───
DATABASE_URL=postgres://user:password@ep-xxx.neon.tech/soke?sslmode=require

# ─── Clerk Authentication ───
# Get your keys at https://dashboard.clerk.com
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_placeholder_replace_with_your_key
CLERK_SECRET_KEY=sk_test_placeholder_replace_with_your_key

# Clerk webhook secret (for syncing users to DB)
CLERK_WEBHOOK_SECRET=whsec_placeholder_replace_with_your_key

# ─── Clerk OAuth (Google/Gmail) ───
# Enable Google OAuth in Clerk Dashboard → User & Authentication → Social
# No additional env vars needed — configured in Clerk dashboard

# ─── App URLs ───
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ─── JWT Secret (for legacy agency auth — being replaced by Clerk) ───
JWT_SECRET=your-jwt-secret-key

# ─── Push Notifications (Web Push / VAPID) ───
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@soke.app

# ─── Super Admin ───
# The super admin email that has access to the super admin dashboard
SUPER_ADMIN_EMAIL=insights793@gmail.com

# ─── Prisma (optional — uses same DATABASE_URL) ───
# Run `npx prisma generate` after install
# Run `npx prisma db push` to sync schema

# ─── Kimi K3 AI (Moonshot AI) ───
# Get your key at https://platform.kimi.ai
# The API is OpenAI-compatible at https://api.moonshot.ai/v1
KIMI_API_KEY=
KIMI_MODEL=kimi-k3
KIMI_BASE_URL=https://api.moonshot.ai/v1

# ─── MapTiler (satellite hybrid map) ───
# Get your key at https://cloud.maptiler.com
NEXT_PUBLIC_MAPTILER_API_KEY=kShyNUYFHeQYewaHssTD
# Legacy Google Maps (deprecated)
# NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
# GOOGLE_MAPS_SERVER_KEY=
