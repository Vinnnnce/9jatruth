# Admin Dashboard Environment Variables
# Point to the NestJS backend API (includes global prefix api/v1)
# Supports both VITE_API_URL (legacy) and VITE_API_BASE_URL (new)
VITE_API_URL=http://localhost:3000/api/v1

# Production backend URL (uncomment for production builds)
# VITE_API_URL=https://api.9jatruth.com/api/v1
# VITE_API_BASE_URL=https://api.9jatruth.com/api/v1

VITE_APP_NAME=9jaTruth Admin
VITE_APP_VERSION=1.0.0
